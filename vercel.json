{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__rota=$1"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/entrar",
      "destination": "/app.html"
    },
    {
      "source": "/r/:token",
      "destination": "/relatorio.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/termos",
      "destination": "/termos.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "no-store"
        },
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "same-origin"
        },
        {
          "key": "x-frame-options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}