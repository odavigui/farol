# ---------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e configure as mesmas
# variaveis em Vercel -> Settings -> Environment Variables.
# NUNCA versione o arquivo com os valores reais.
# ---------------------------------------------------------------

# ---- banco ----
# Deixe em branco para usar SQLite local durante o desenvolvimento.
# Em producao a Vercel precisa das duas de baixo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Forca o adaptador. Sem isto: supabase se SUPABASE_URL existir, senao sqlite.
# BANCO=sqlite

# ---- pagamento ----
SEGREDO_WEBHOOK=
PRECO_ESSENCIAL=
PRECO_AGENCIA=
PRECO_ESTUDIO=

# ---- e-mail (recuperacao de senha) ----
# Modos: log (nao envia, imprime o link no terminal) | smtp | http
# Sem SMTP_USUARIO o sistema usa "log" sozinho — bom para desenvolver.
EMAIL_MODO=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_USUARIO=seuendereco@gmail.com
# NAO e a senha da sua conta Google. E uma "Senha de app" de 16 letras,
# que so aparece depois de ligar a verificacao em duas etapas:
# myaccount.google.com -> Seguranca -> Senhas de app
SMTP_SENHA=
EMAIL_DE=seuendereco@gmail.com
EMAIL_NOME=Farol

# Endereco do site, usado para montar o link do e-mail.
# Na Vercel: https://seuprojeto.vercel.app (ou seu dominio proprio).
# Sem isto o link e montado com o cabecalho Host, que vem de quem chama.
URL_BASE=

# ---- servidor local ----
PORTA=3000
